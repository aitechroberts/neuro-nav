FROM nvidia/cuda:12.6.0-base-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install basic utils for the smoke test script
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    coreutils \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set default environment variables matching the architecture doc / typical setup
ENV DATA_ROOT="/mnt/data" \
    OUTPUT_ROOT="/mnt/output" \
    CKPT_DIR="/mnt/checkpoints" \
    SCENE_ID="test-scene"

WORKDIR /app

COPY neuro-nav/gpu-batch-infra/entrypoint_gpu_jobs_test.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
