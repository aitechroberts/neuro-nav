FROM nvidia/cuda:12.6.0-cudnn9-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_CACHE_DIR=/root/.cache/uv

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv \
    git curl wget ca-certificates \
    ffmpeg \
    libgl1 libglib2.0-0 libsm6 libxext6 libxrender1 \
    && rm -rf /var/lib/apt/lists/*

# Install uv (project manager)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && echo 'export PATH="/root/.cargo/bin:$PATH"' >> /etc/profile.d/uv.sh
ENV PATH="/root/.cargo/bin:$PATH"

WORKDIR /app/neuro-nav

# Copy project manifest first for better layer caching
COPY neuro-nav/pyproject.toml ./pyproject.toml
# If you create a uv.lock later, copy it here too:
# COPY neuro-nav/uv.lock ./uv.lock

# Resolve and install dependencies into a local venv using uv
RUN uv sync --no-dev

# Ensure CUDA-enabled PyTorch inside the venv (aligns with pyproject pins)
RUN . .venv/bin/activate \
    && python -m pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cu126 \
        torch==2.6.0 torchvision==0.21.0 torchaudio==2.6.0

# Add the rest of the source after deps to maximize cache hits
COPY neuro-nav /app/neuro-nav

# Runtime PATH to the venv, and module visibility
ENV PATH="/app/neuro-nav/.venv/bin:$PATH" \
    PYTHONPATH=/app/neuro-nav

# Default runtime config via env (override per-task in ECS)
ENV REPO_ROOT=/app/neuro-nav \
    DATA_ROOT=/mnt/data \
    DATASET_ROOT=/mnt/data/Replica \
    SCENE_ID=room0 \
    EXP_SUFFIX=batch_vlm \
    DET_EXP_SUFFIX=s_detections \
    FORCE_DET=true \
    MAKE_EDGES=true \
    SAVE_JSON=true \
    SAVE_PCD=true \
    VIS_RENDER=false \
    DEVICE=cuda \
    STRIDE=1 \
    START=0 \
    END=-1 \
    PERIODIC_PCD=false \
    PERIODIC_PCD_INTERVAL=10

# Optional: OpenAI key for VLM edges; set in task env
# ENV OPENAI_API_KEY=""

COPY gpu-batch-infra/entrypoint_batch_vlm.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

CMD ["/entrypoint.sh"]
